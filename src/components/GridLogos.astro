---
const { posts, categoria, class: className } = Astro.props;

// Reemplaza los parametros de Cloudinary por los que queremos.
function cloud(src, params) {
  if (!src) return src;
  return src.replace(/\/image\/upload\/[^/]+\/v/, `/image/upload/${params}/v`);
}
const GRANDE = "c_limit,w_1400,f_auto,q_auto";
---

<div class:list={[className, "w-full px-4 md:px-6 pt-2 pb-24"]}>
  <div class="columns-1 sm:columns-2 lg:columns-4 gap-8 md:gap-11">
    {
      [...posts].map(({ url, frontmatter }) => {
        const portada = cloud(frontmatter.cover, GRANDE);
        // La segunda imagen (hover) sale del campo LOGO del panel.
        const segunda =
          frontmatter.logo && frontmatter.logo !== frontmatter.cover
            ? cloud(frontmatter.logo, GRANDE)
            : null;
        const atenuado = categoria && categoria !== frontmatter.category;
        return (
          <a
            href={url}
            class="grupo-proyecto group block break-inside-avoid mb-12 md:mb-16"
            data-hover={segunda}
          >
            <div
              class:list={[
                "marco relative w-full overflow-hidden bg-neutral-50 transition-all duration-500",
                { "grayscale opacity-20": atenuado },
              ]}
            >
              <img
                class="imagen-proyecto w-full h-auto block"
                src={portada}
                data-base={portada}
                alt={frontmatter.title}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div
              class:list={[
                "pt-3 transition-opacity duration-300",
                "opacity-100 md:opacity-0 md:group-hover:opacity-100",
                { "!opacity-20": atenuado },
              ]}
            >
              <h2 class="text-sm font-thin tracking-[0.13em] uppercase">
                {frontmatter.title}
              </h2>
              <h2 class="text-sm font-thin tracking-[0.02em] opacity-50">
                {frontmatter.subtitle || frontmatter.category}
              </h2>
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<script is:inline data-astro-rerun>
  (function () {
    document.querySelectorAll(".grupo-proyecto").forEach(function (tarjeta) {
      var img = tarjeta.querySelector(".imagen-proyecto");
      var alterna = tarjeta.getAttribute("data-hover");
      if (!img || !alterna || alterna === "null") return;

      var base = img.getAttribute("data-base");
      var precarga = new Image();
      precarga.src = alterna;

      tarjeta.addEventListener("mouseenter", function () {
        img.src = alterna;
      });
      tarjeta.addEventListener("mouseleave", function () {
        img.src = base;
      });
    });
  })();
</script>
