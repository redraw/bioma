---
const { posts, categoria, class: className } = Astro.props;

function cloud(src, params) {
  if (!src) return src;
  return src.replace(/\/image\/upload\/[^/]+\/v/, `/image/upload/${params}/v`);
}
const GRANDE = "c_limit,w_1400,f_auto,q_auto";
---

<div class:list={[className, "w-full px-4 md:px-6 pt-2 pb-24"]}>
  <!-- El orden del DOM es el orden elegido en SITE.
       El script reparte las tarjetas en columnas de izquierda a derecha. -->
  <div
    id="grilla-proyectos"
    class="flex flex-col md:flex-row gap-0 md:gap-11 items-start"
  >
    {
      [...posts].map(({ url, frontmatter }) => {
        const portada = cloud(frontmatter.cover, GRANDE);
        const segunda =
          frontmatter.logo && frontmatter.logo !== frontmatter.cover
            ? cloud(frontmatter.logo, GRANDE)
            : null;
        const atenuado = categoria && categoria !== frontmatter.category;
        return (
          <a
            href={url}
            class="grupo-proyecto group block w-full mb-12 md:mb-16"
          >
            <div
              class:list={[
                "relative w-full overflow-hidden bg-neutral-50 transition-all duration-500",
                { "grayscale opacity-20": atenuado },
              ]}
            >
              {/* Esta imagen define la caja: su proporcion manda siempre */}
              <img
                class="w-full h-auto block"
                src={portada}
                alt={frontmatter.title}
                loading="lazy"
                decoding="async"
              />
              {/* La segunda se recorta dentro de esa misma caja */}
              {segunda && (
                <img
                  class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-300 md:group-hover:opacity-100"
                  src={segunda}
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <div
              class:list={[
                "pt-3 transition-opacity duration-300",
                "opacity-100 md:opacity-0 md:group-hover:opacity-100",
                { "!opacity-20": atenuado },
              ]}
            >
              <h2 class="text-sm font-thin tracking-[0.13em] uppercase">
                {frontmatter.title}
              </h2>
              <h2 class="text-sm font-thin tracking-[0.02em] opacity-50">
                {frontmatter.subtitle || frontmatter.category}
              </h2>
            </div>
          </a>
        );
      })
    }
  </div>
</div>

<script is:inline data-astro-rerun>
  (function () {
    var cont = document.getElementById("grilla-proyectos");
    if (!cont) return;

    var tarjetas = Array.prototype.slice.call(
      cont.querySelectorAll(".grupo-proyecto")
    );
    if (!tarjetas.length) return;

    function cuantasColumnas() {
      var w = window.innerWidth;
      if (w >= 1024) return 4;
      if (w >= 640) return 2;
      return 1;
    }

    function repartir() {
      var n = cuantasColumnas();
      if (cont.getAttribute("data-cols") === String(n)) return;
      cont.setAttribute("data-cols", String(n));

      while (cont.firstChild) cont.removeChild(cont.firstChild);

      if (n === 1) {
        tarjetas.forEach(function (t) {
          cont.appendChild(t);
        });
        return;
      }

      var columnas = [];
      for (var i = 0; i < n; i++) {
        var col = document.createElement("div");
        col.className = "flex-1 min-w-0";
        cont.appendChild(col);
        columnas.push(col);
      }
      // De izquierda a derecha: la tarjeta 1 va a la columna 1, la 2 a la 2...
      tarjetas.forEach(function (t, i) {
        columnas[i % n].appendChild(t);
      });
    }

    repartir();

    var reloj;
    window.addEventListener("resize", function () {
      clearTimeout(reloj);
      reloj = setTimeout(repartir, 150);
    });
  })();
</script>
